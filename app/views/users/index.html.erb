<h1>Users</h1>
<p><%= link_to "Add user", new_user_path %></p>
<% if @users.empty? %>
  <p>No users yet.</p>
<% else %>
  <table>
    <thead><tr><th>Username</th><th>Actions</th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.username %></td>
          <td class="actions">
            <%= link_to "Show", user_path(user) %>
            <%= link_to "Edit", edit_user_path(user) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
