<%= form_with(model: user_book) do |form| %>
  <% if user_book.errors.any? %>
    <ul class="errors" role="alert">
      <% user_book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="field">
    <%= form.label :user_id, "User" %>
    <%= form.collection_select :user_id, @users, :id, :username, prompt: "Select a user" %>
  </div>
  <div class="field">
    <%= form.label :book_id, "Book" %>
    <%= form.collection_select :book_id, @books, :id, :title, prompt: "Select a book" %>
  </div>
  <%= form.submit %>
<% end %>
