<h1>Book Collection</h1>
<p><%= link_to "Add book", new_book_path %></p>
<% if @books.empty? %>
  <p>No books yet.</p>
<% else %>
  <table>
    <thead><tr><th>Title</th><th>Actions</th></tr></thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td class="actions">
            <%= link_to "Show", book_path(book) %>
            <%= link_to "Edit", edit_book_path(book) %>
            <%= link_to "Delete", delete_book_path(book) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
